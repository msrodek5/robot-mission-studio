---
import Layout from '../layouts/Layout.astro';
import DeployProbe from '../components/DeployProbe.tsx';

export const prerender = true;
---

<Layout title="Robot Mission Studio">
  <main class="mx-auto flex min-h-full max-w-2xl flex-col justify-center gap-8 px-6 py-16">
    <div>
      <p class="text-sm font-medium tracking-widest text-cyan-400 uppercase">
        Milestone 0
      </p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight">
        Robot Mission Studio
      </h1>
      <p class="mt-4 text-slate-400">
        Plan a warehouse robot's mission in plain language, watch it run on a
        deterministic grid simulation, and get an explanation when it fails.
      </p>
    </div>

    <DeployProbe client:load />

    <p class="text-sm text-slate-500">
      Auth, the layout editor, and the planner arrive in later milestones. This
      page exists so the deploy pipeline is real before any of them are built.
    </p>
  </main>
</Layout>
