---
import Layout from '../layouts/Layout.astro';
import DeployProbe from '../components/DeployProbe.tsx';

export const prerender = true;
---

<Layout title="Robot Mission Studio">
  <main class="mx-auto flex min-h-full max-w-2xl flex-col justify-center gap-8 px-6 py-16">
    <div>
      <h1 class="text-4xl font-semibold tracking-tight">
        Robot Mission Studio
      </h1>
      <p class="mt-4 text-slate-400">
        Plan a warehouse robot's mission in plain language, watch it run on a
        deterministic grid simulation, and get an explanation when it fails.
      </p>
    </div>

    <DeployProbe client:load />

    <p class="text-sm">
      <a href="/login" class="text-cyan-400 underline">Log in</a>
      <span class="text-slate-600"> · </span>
      <a href="/signup" class="text-cyan-400 underline">Sign up</a>
    </p>

    <p class="text-sm text-slate-500">
      The layout editor and the planner arrive in later milestones. This page
      exists so the deploy pipeline is real before any of them are built.
    </p>
  </main>
</Layout>
