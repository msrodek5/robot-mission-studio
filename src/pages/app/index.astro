---
export const prerender = false;

const { user } = Astro.locals;

// Middleware already guards /app/*. Re-checking keeps the type honest without a
// non-null assertion and fails closed if that guard ever regresses.
if (!user) return Astro.redirect('/login', 302);

// `/app` has no content of its own: layouts are the only thing to do, and the
// login flow lands here by default. Redirecting keeps one canonical home rather
// than a placeholder page with nothing to click. When missions and runs arrive
// this becomes a real hub.
return Astro.redirect('/app/layouts', 302);
---
