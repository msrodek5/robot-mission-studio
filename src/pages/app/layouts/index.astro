---
import { LayoutList } from '../../../components/layout-editor/LayoutList';
import {
  LAYOUT_COLUMNS,
  parseLayoutRow,
  toLayoutRecord,
} from '../../../lib/layout/layout-api';
import Layout from '../../../layouts/Layout.astro';

export const prerender = false;

const { supabase, user } = Astro.locals;

// Middleware already guards /app/*. Re-checking keeps the type honest without a
// non-null assertion and fails closed if that guard ever regresses.
if (!user) return Astro.redirect('/login', 302);

// Read server-side so the list is in the first paint. Mutations go through
// /api/layouts. No user filter needed: the select policy scopes this already.
const { data, error } = await supabase
  .from('layouts')
  .select(LAYOUT_COLUMNS)
  .order('updated_at', { ascending: false });

const layouts = (data ?? []).map((row) => toLayoutRecord(parseLayoutRow(row)));
---

<Layout title="Layouts — Robot Mission Studio">
  <main class="mx-auto flex min-h-full max-w-3xl flex-col gap-6 px-6 py-12">
    <div class="flex items-baseline justify-between">
      <h1 class="text-2xl font-semibold tracking-tight">Layouts</h1>

      <form method="post" action="/logout">
        <button type="submit" class="rounded bg-slate-700 px-2 py-1 text-xs">Log out</button>
      </form>
    </div>

    {
      error && (
        <p class="rounded border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-300">
          Could not load layouts: {error.message}
        </p>
      )
    }

    <LayoutList initial={layouts} client:load />
  </main>
</Layout>
