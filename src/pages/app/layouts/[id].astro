---
import { LayoutEditor } from '../../../components/layout-editor/LayoutEditor';
import { RunHistory } from '../../../components/playback/RunHistory';
import { RunLauncher } from '../../../components/playback/RunLauncher';
import {
  LAYOUT_COLUMNS,
  isLayoutId,
  parseLayoutRow,
  toLayoutRecord,
} from '../../../lib/layout/layout-api';
import { RUN_COLUMNS, parseRunRow, toRunRecord } from '../../../lib/runs/run-api';
import Layout from '../../../layouts/Layout.astro';

export const prerender = false;

const { supabase, user } = Astro.locals;

if (!user) return Astro.redirect('/login', 302);

// A malformed id cannot name a row, and querying with it would raise a Postgres
// uuid syntax error rather than a clean miss.
if (!isLayoutId(Astro.params.id)) {
  return new Response('Layout not found', { status: 404 });
}

const { data } = await supabase
  .from('layouts')
  .select(LAYOUT_COLUMNS)
  .eq('id', Astro.params.id)
  .maybeSingle();

// Another user's layout is invisible under RLS, so it arrives here as no row —
// and leaves as 404, never 403. Nothing confirms the id exists.
if (!data) {
  return new Response('Layout not found', { status: 404 });
}

const record = toLayoutRecord(parseLayoutRow(data));

// Run history, server-rendered so it is in the first paint. `runs` has no
// layout_id, so the layout's missions come first. No user filter on either
// query: the select policies already scope them to this user.
const { data: missionRows } = await supabase
  .from('missions')
  .select('id, name, source')
  .eq('layout_id', record.id)
  .order('created_at', { ascending: false });

const missions = (missionRows ?? []) as { id: string; name: string; source: string }[];
const missionNameById = new Map(missions.map((mission) => [mission.id, mission.name]));

const { data: runRows } =
  missions.length === 0
    ? { data: [] }
    : await supabase
        .from('runs')
        .select(RUN_COLUMNS)
        .in(
          'mission_id',
          missions.map((mission) => mission.id),
        )
        .order('created_at', { ascending: false });

const runs = (runRows ?? []).map((row) => toRunRecord(parseRunRow(row)));

const missionNames = Object.fromEntries(
  runs.map((run) => [run.id, missionNameById.get(run.missionId) ?? 'Mission']),
);
---

<Layout title={`${record.name} — Robot Mission Studio`}>
  <main class="mx-auto flex min-h-full max-w-4xl flex-col gap-6 px-6 py-12">
    <div class="flex items-baseline justify-between">
      <a href="/app/layouts" class="text-sm text-cyan-400 underline">&larr; All layouts</a>

      <form method="post" action="/logout">
        <button type="submit" class="rounded bg-slate-700 px-2 py-1 text-xs">Log out</button>
      </form>
    </div>

    <LayoutEditor record={record} client:load />

    <RunLauncher record={record} client:load />

    <section class="flex flex-col gap-3 rounded border border-slate-700 px-4 py-3">
      <div class="flex items-baseline justify-between">
        <h2 class="text-sm font-semibold tracking-wide uppercase">Missions</h2>

        <a
          href={`/app/layouts/${record.id}/missions/new`}
          class="rounded bg-cyan-600 px-3 py-1.5 text-sm font-medium"
        >
          Plan with AI
        </a>
      </div>

      {
        missions.length === 0 ? (
          <p class="text-sm text-slate-400">
            No missions yet. Describe one in plain English and the planner will draft the steps.
          </p>
        ) : (
          <ul class="flex flex-col gap-1">
            {missions.map((mission) => (
              <li>
                <a
                  href={`/app/missions/${mission.id}`}
                  class="flex items-baseline justify-between rounded px-2 py-1 text-sm hover:bg-slate-800"
                >
                  <span>{mission.name}</span>
                  <span class="font-mono text-xs text-slate-500">{mission.source}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <RunHistory layoutId={record.id} runs={runs} missionNames={missionNames} />
  </main>
</Layout>
