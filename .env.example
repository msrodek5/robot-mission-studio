# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Supabase (M2) ---
# Browser-safe: anon key is protected by row-level security.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never import into anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (M5) ---
OPENROUTER_API_KEY=
# Pinned, not hardcoded. Planning a 6-step mission is not a frontier-model task.
OPENROUTER_MODEL=
