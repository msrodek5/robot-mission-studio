# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Supabase (M2) ---
# Browser-safe: anon key is protected by row-level security. Required by the app.
# Both are inlined into the client bundle at build time, so they have to be set
# for `npm run build`, not only at runtime.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never import into anything that ships to the browser.
# Not used by the app itself. `npm run test:rls` and `npm run test:e2e` need it to
# create and delete their throwaway users; every assertion runs over the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (M5, M6) ---
# Powers the planner and the failure postmortem. Both call the model from server
# code only. Missing it surfaces as a typed PROVIDER_ERROR in the UI, not a 500.
ANTHROPIC_API_KEY=
# Pinned, not hardcoded. Planning a 6-step mission is not a frontier-model task.
# Optional; defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=
# Optional, and normally left empty. Read by the Anthropic SDK. The Playwright
# suite sets it to its own stub server so no E2E run can make a real model call —
# see tests/e2e/support/anthropic-stub.mjs.
ANTHROPIC_BASE_URL=

# --- Playwright (M7) ---
# Both optional. The E2E app deliberately runs on 4331 rather than Astro's 4321,
# so `reuseExistingServer` can never adopt a dev server you left running.
E2E_BASE_URL=
E2E_STUB_PORT=
